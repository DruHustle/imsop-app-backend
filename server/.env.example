NODE_ENV=development
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://imsop:imsop-postgres-local@localhost:5432/imsop_supply_chain
JWT_SECRET=replace-with-at-least-32-random-characters

PASSWORD_RESET_BASE_URL=http://localhost:5173/#/reset-password
EMAIL_PROVIDER=gmail
GMAIL_FROM=notifications.imsop@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Switch EMAIL_PROVIDER to resend after verifying a sender domain.
RESEND_API_KEY=
EMAIL_FROM=IMSOP <onboarding@resend.dev>

LOGISTICS_WEBHOOK_SECRETS={"example-provider":"replace-with-at-least-32-random-characters"}

# Production requires an independent 32-byte hex key for encrypted recovery queue material.
# Generate and store it using the existing secret manager; never commit a real value.
RESET_DELIVERY_KEY=
# Migration principal may differ from the runtime role. Default runtime does not run migrations.
MIGRATION_DATABASE_URL=
RUN_NODE_MIGRATIONS=false

# Optional operational mail: defaults off, users must opt in per workspace.
EMAIL_NOTIFICATIONS_ENABLED=false
# Optional server-side forecast adapter; no provider subscription is provisioned.
FORECAST_PROVIDER_URL=
FORECAST_PROVIDER_NAME=
FORECAST_PROVIDER_TOKEN=
FORECAST_MAX_HORIZON_DAYS=30
